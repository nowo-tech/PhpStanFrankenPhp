parameters:
    level: 8
    paths:
        - src
        - tests
    excludePaths:
        - tests/Fixtures
        - tests/Unit/DirectProcessNodeCoverageTest.php
    treatPhpDocTypesAsCertain: false
    # REQ-CS-006: never silence findings here — fix the code instead
    ignoreErrors: []

includes:
    - vendor/phpstan/phpstan-phpunit/extension.neon
    - vendor/phpstan/phpstan-phpunit/rules.neon
