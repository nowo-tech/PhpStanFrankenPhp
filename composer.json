{
    "name": "nowo-tech/phpstan-frankenphp",
    "description": "PHPStan rules that help you migrate from PHP-FPM to FrankenPHP classic, then to worker mode. Rules are split by level with demos for every case.",
    "type": "phpstan-extension",
    "license": "MIT",
    "keywords": [
        "phpstan",
        "frankenphp",
        "php-fpm",
        "worker",
        "static-analysis",
        "migration",
        "symfony",
        "laravel",
        "long-running",
        "code-quality"
    ],
    "homepage": "https://github.com/nowo-tech/PhpStanFrankenPhp",
    "support": {
        "issues": "https://github.com/nowo-tech/PhpStanFrankenPhp/issues",
        "source": "https://github.com/nowo-tech/PhpStanFrankenPhp"
    },
    "authors": [
        {
            "name": "Héctor Franco Aceituno",
            "email": "hectorfranco@nowo.tech",
            "homepage": "https://github.com/HecFranco",
            "role": "Developer"
        },
        {
            "name": "Nowo.tech",
            "homepage": "https://nowo.tech"
        }
    ],
    "require": {
        "php": ">=8.2 <8.6",
        "phpstan/phpstan": "^2.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^10.0 || ^11.0",
        "rector/rector": "^2.0",
        "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
        "symfony/process": "^6.4 || ^7.0 || ^8.0",
        "symfony/service-contracts": "^2.5 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "NowoTech\\PhpStanFrankenPhp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NowoTech\\PhpStanFrankenPhp\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Fixtures"
        ]
    },
    "extra": {
        "phpstan": {
            "includes": [
                "extension.neon"
            ]
        },
        "branch-alias": {
            "dev-main": "1.0.x-dev"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always --no-coverage",
        "test-coverage": "phpunit --colors=always --coverage-html coverage --coverage-clover coverage.xml --coverage-text | tee coverage-php.txt && sh .scripts/php-coverage-percent.sh coverage-php.txt",
        "coverage-check": "phpunit --colors=always --coverage-text=coverage-output.txt --coverage-clover coverage.xml && sh .scripts/coverage-fail-under.sh coverage-output.txt 100",
        "test-coverage-100": "@coverage-check",
        "cs-check": "php-cs-fixer fix --dry-run --diff --config=.php-cs-fixer.dist.php",
        "cs-fix": "php-cs-fixer fix --config=.php-cs-fixer.dist.php",
        "rector": "rector process",
        "rector-dry": "rector process --dry-run --no-progress-bar",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "demo-classic": "phpstan analyse -c demo/phpstan-classic.neon --memory-limit=512M --error-format=table",
        "demo-worker": "phpstan analyse -c demo/phpstan-worker.neon --memory-limit=512M --error-format=table",
        "demo-hardening": "phpstan analyse -c demo/phpstan-hardening.neon --memory-limit=512M --error-format=table",
        "demo-all": [
            "@demo-classic",
            "@demo-worker",
            "@demo-hardening"
        ],
        "qa": [
            "@cs-check",
            "@test",
            "@phpstan"
        ],
        "demo-classic-good": "phpstan analyse -c demo/phpstan-classic-good.neon --memory-limit=512M",
        "demo-worker-good": "phpstan analyse -c demo/phpstan-worker-good.neon --memory-limit=512M",
        "demo-hardening-good": "phpstan analyse -c demo/phpstan-hardening-good.neon --memory-limit=512M",
        "demo-worker-strict": "phpstan analyse -c demo/phpstan-worker-strict.neon --memory-limit=512M --error-format=table"
    },
    "scripts-descriptions": {
        "test": "Run PHPUnit tests",
        "test-coverage": "Run PHPUnit tests with code coverage",
        "coverage-check": "Fail if PHP line coverage is under 100%",
        "test-coverage-100": "Alias for coverage-check",
        "cs-check": "Check code style with PHP-CS-Fixer",
        "cs-fix": "Fix code style with PHP-CS-Fixer",
        "rector": "Apply Rector refactors",
        "rector-dry": "Run Rector in dry-run mode",
        "phpstan": "Run PHPStan static analysis on the package itself",
        "demo-classic": "Analyse demo fixtures for classic (FPM → FrankenPHP classic) rules",
        "demo-worker": "Analyse demo fixtures for worker rules",
        "demo-hardening": "Analyse demo fixtures for hardening rules",
        "demo-all": "Run all demo analyses (expect findings on intentional violations)",
        "qa": "Run all quality assurance checks",
        "demo-classic-good": "Analyse compliant classic demos (must be clean)",
        "demo-worker-good": "Analyse compliant worker demos (must be clean)",
        "demo-hardening-good": "Analyse compliant hardening demos (must be clean)",
        "demo-worker-strict": "Analyse demos with worker-strict ruleset (also flags $_GET/$_POST/…)"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        },
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "archive": {
        "exclude": [
            "/demo",
            "/.cursor"
        ]
    }
}
