{# demo/home.html.twig #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>PhpStanFrankenPhp — Symfony 8 demo</title>
    <style>
        :root { color-scheme: light; --ink: #1a1a1a; --muted: #5c5c5c; --line: #e6e6e6; --accent: #0b6e4f; }
        body { margin: 0; font-family: "Iowan Old Style", "Palatino Linotype", Palatino, serif; color: var(--ink); background: linear-gradient(160deg, #f7f3ea 0%, #eef5f1 55%, #e7eef8 100%); min-height: 100vh; }
        main { max-width: 42rem; margin: 0 auto; padding: 4rem 1.25rem 3rem; }
        h1 { font-size: clamp(2rem, 4vw, 2.75rem); letter-spacing: -0.03em; margin: 0 0 0.5rem; }
        p { color: var(--muted); line-height: 1.5; }
        dl { display: grid; grid-template-columns: 10rem 1fr; gap: 0.5rem 1rem; margin: 2rem 0; padding: 1.25rem 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
        dt { font-weight: 600; } dd { margin: 0; font-family: ui-monospace, monospace; color: var(--accent); }
        code { font-family: ui-monospace, monospace; font-size: 0.92em; }
        ol { padding-left: 1.2rem; color: var(--muted); }
    </style>
</head>
<body>
<main>
    <h1>PhpStanFrankenPhp</h1>
    <p>Symfony 8 + FrankenPHP demo. The homepage is worker-safe; intentional anti-patterns live under <code>src/AntiPattern/</code> for PHPStan levels.</p>
    <dl>
        <dt>FRANKENPHP_MODE</dt><dd>{{ frankenphpMode }}</dd>
        <dt>Request hits</dt><dd>{{ hits }} <span style="color:var(--muted)">(resets between worker requests)</span></dd>
    </dl>
    <ol>
        <li><code>composer phpstan-classic</code> — FPM → classic</li>
        <li><code>composer phpstan-worker</code> — classic → worker</li>
        <li><code>composer phpstan-hardening</code> — all levels</li>
    </ol>
</main>
</body>
</html>
