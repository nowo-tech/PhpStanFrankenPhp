{# demo/home.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}PhpStanFrankenPhp — Symfony 8 demo{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'PhpStanFrankenPhp',
        intro: 'Symfony 8 + FrankenPHP demo. The homepage is worker-safe; intentional anti-patterns live under src/AntiPattern/ for PHPStan levels.',
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Runtime', kind: 'detail', testid: 'demo-runtime', frankenphpMode: frankenphpMode, hits: hits} %}
        {% block section_body %}
            <dl class="nowo-ui-dl">
                <div><dt>FRANKENPHP_MODE</dt><dd><code class="nowo-ui-code" data-testid="demo-mode">{{ frankenphpMode }}</code></dd></div>
                <div><dt>Request hits</dt><dd><span data-testid="demo-hits">{{ hits }}</span> <span class="nowo-ui-muted">(resets between worker requests)</span></dd></div>
            </dl>
        {% endblock %}
    {% endembed %}

    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'PHPStan levels', intro: 'Run them inside the demo container.', kind: 'list'} %}
        {% block section_body %}
            <ol>
                <li><code class="nowo-ui-code">composer phpstan-classic</code> — FPM → classic</li>
                <li><code class="nowo-ui-code">composer phpstan-worker</code> — classic → worker</li>
                <li><code class="nowo-ui-code">composer phpstan-hardening</code> — all levels</li>
            </ol>
        {% endblock %}
    {% endembed %}
{% endblock %}
