# Local environment: machine-specific values and secrets are never committed (REQ-DEMO-003).
.env
.env.dev
.env.local
.env.*.local
/.env.local
/.env.local.php
/.env.*.local

# Dependencies: installed in the container; the demo always resolves the mounted package.
# composer.lock and symfony.lock are tracked so the Symfony 8.1.x resolution is reproducible (REQ-DEMO-012).
/vendor/
# Agent guide generated by the Symfony Flex recipe (not part of the demo sources).
/AGENTS.md

# Runtime cache, logs and published assets: regenerated by Symfony on boot.
/public/bundles/
/var/

# Test and coverage artifacts: produced locally / in CI only.
/.phpunit.cache/
/.phpunit.result.cache
/phpunit.xml
/coverage/
/coverage.xml

# Archives / compressed: never part of the demo sources.
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Symfony Flex managed blocks (kept so recipes stay idempotent).
###> symfony/framework-bundle ###
/.env.local
/.env.local.php
/.env.*.local
/config/secrets/prod/prod.decrypt.private.php
/public/bundles/
/var/
/vendor/
# Agent guide generated by the Symfony Flex recipe (not part of the demo sources).
/AGENTS.md
###< symfony/framework-bundle ###

