# Demo environment template (REQ-DEMO-003). Copy to .env (cp .env.example .env) and adjust.
# Do not commit .env, .env.dev or .env.*.local files.

# APP_ENV: Symfony environment (dev/test/prod). The demo runs in `dev`.
APP_ENV=dev

# APP_SECRET: Secret used for CSRF/session signing. Local-only placeholder; never reuse in production.
APP_SECRET=change_this_secret_key_to_a_random_value

# APP_DEBUG: Enable detailed debug output (1 in dev, 0 in prod).
APP_DEBUG=1

# FRANKENPHP_MODE: FrankenPHP runtime mode — `classic` (one process per request) or `worker` (long-lived workers).
# Default: worker. Recreate with `docker compose up -d` after change.
FRANKENPHP_MODE=worker

# PORT: Host HTTP port exposed by docker-compose.
PORT=8090

# TRUSTED_PROXIES: Proxies whose X-Forwarded-* headers are trusted (Caddy in front of PHP).
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR

# DEFAULT_URI: Base URL used to generate URLs from the CLI.
DEFAULT_URI=http://localhost
