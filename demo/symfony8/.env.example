# Demo environment template. Copy to .env (cp .env.example .env) and adjust.
# Do not commit .env.

APP_ENV=dev
APP_SECRET=change_this_secret_key_to_a_random_value
APP_DEBUG=1

# FRANKENPHP_MODE: classic | worker (default worker). Recreate with docker compose up -d after change.
FRANKENPHP_MODE=worker

# HTTP port exposed by docker-compose
PORT=8090

TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
DEFAULT_URI=http://localhost
