# Level 2 — FrankenPHP classic → worker
parameters:
    frankenphp:
        # When true, also flag $_GET/$_POST/$_COOKIE/$_FILES/$_REQUEST/$_SERVER.
        # Default false: FrankenPHP resets those between requests; $_ENV/$_SESSION stay flagged.
        flagRequestSuperglobals: false
        # When true, flag classes that mutate $this->… without ResetInterface (kernel reuse).
        flagMissingResetInterface: false
        # Load readiness (opt-in, heuristic; ruleset-worker-load.neon enables the first, second and fourth).
        # rollBack() in a catch/finally after a nested begin or flush (DBAL 4: 1305 after a deadlock, nesting stuck).
        flagRollbackAfterNestedBegin: false
        # EntityManager::flush() inside beginTransaction()…commit() or a wrapInTransaction()/transactional() callable.
        flagFlushInHandWrittenTransaction: false
        # Raw flush() in a class with no closed-EntityManager recovery (noisier: enable on its own).
        flagFlushWithoutClosedManagerRecovery: false
        # Recursion over children/parent/replies/… with no depth parameter and no visited set.
        flagUnboundedRecursion: false

services:
    -
        class: NowoTech\PhpStanFrankenPhp\Rule\Worker\NoMutableStaticPropertyRule
        tags:
            - phpstan.rules.rule
    -
        class: NowoTech\PhpStanFrankenPhp\Rule\Worker\NoStaticLocalVariableRule
        tags:
            - phpstan.rules.rule
    -
        class: NowoTech\PhpStanFrankenPhp\Rule\Worker\NoGlobalStateWriteRule
        tags:
            - phpstan.rules.rule
    -
        class: NowoTech\PhpStanFrankenPhp\Rule\Worker\NoSuperglobalAccessRule
        arguments:
            flagRequestSuperglobals: %frankenphp.flagRequestSuperglobals%
        tags:
            - phpstan.rules.rule
    -
        class: NowoTech\PhpStanFrankenPhp\Rule\Worker\NoNativeSessionApiRule
        tags:
            - phpstan.rules.rule
    -
        class: NowoTech\PhpStanFrankenPhp\Rule\Worker\NoPersistentIniSetRule
        tags:
            - phpstan.rules.rule
    -
        class: NowoTech\PhpStanFrankenPhp\Rule\Worker\NoSingletonGetInstanceRule
        tags:
            - phpstan.rules.rule
    -
        class: NowoTech\PhpStanFrankenPhp\Rule\Worker\NoRegisterShutdownFunctionRule
        tags:
            - phpstan.rules.rule
    -
        class: NowoTech\PhpStanFrankenPhp\Rule\Worker\NoSetErrorExceptionHandlerRule
        tags:
            - phpstan.rules.rule
    -
        class: NowoTech\PhpStanFrankenPhp\Rule\Worker\NoChdirRule
        tags:
            - phpstan.rules.rule
    -
        class: NowoTech\PhpStanFrankenPhp\Rule\Worker\NoSetLocaleRule
        tags:
            - phpstan.rules.rule
    -
        class: NowoTech\PhpStanFrankenPhp\Rule\Worker\NoLocaleSetDefaultRule
        tags:
            - phpstan.rules.rule
    -
        class: NowoTech\PhpStanFrankenPhp\Rule\Worker\NoDateDefaultTimezoneSetRule
        tags:
            - phpstan.rules.rule
    -
        class: NowoTech\PhpStanFrankenPhp\Rule\Worker\NoMbEncodingMutationRule
        tags:
            - phpstan.rules.rule
    -
        class: NowoTech\PhpStanFrankenPhp\Rule\Worker\NoErrorReportingMutationRule
        tags:
            - phpstan.rules.rule
    -
        class: NowoTech\PhpStanFrankenPhp\Rule\Worker\NoUmaskRule
        tags:
            - phpstan.rules.rule
    -
        class: NowoTech\PhpStanFrankenPhp\Rule\Worker\NoMissingResetInterfaceRule
        arguments:
            enabled: %frankenphp.flagMissingResetInterface%
        tags:
            - phpstan.rules.rule
    -
        class: NowoTech\PhpStanFrankenPhp\Rule\Worker\NoRollbackAfterNestedBeginRule
        arguments:
            enabled: %frankenphp.flagRollbackAfterNestedBegin%
        tags:
            - phpstan.rules.rule
    -
        class: NowoTech\PhpStanFrankenPhp\Rule\Worker\NoFlushInHandWrittenTransactionRule
        arguments:
            enabled: %frankenphp.flagFlushInHandWrittenTransaction%
        tags:
            - phpstan.rules.rule
    -
        class: NowoTech\PhpStanFrankenPhp\Rule\Worker\NoFlushWithoutClosedManagerRecoveryRule
        arguments:
            enabled: %frankenphp.flagFlushWithoutClosedManagerRecovery%
        tags:
            - phpstan.rules.rule
    -
        class: NowoTech\PhpStanFrankenPhp\Rule\Worker\NoUnboundedRecursionRule
        arguments:
            enabled: %frankenphp.flagUnboundedRecursion%
        tags:
            - phpstan.rules.rule
